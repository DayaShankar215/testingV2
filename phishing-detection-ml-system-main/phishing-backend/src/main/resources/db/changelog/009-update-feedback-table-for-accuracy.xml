<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-update-feedback-table-for-accuracy" author="bini">

        <addColumn tableName="feedback">

            <column name="accurate" type="BOOLEAN"/>

        </addColumn>

        <dropNotNullConstraint
                tableName="feedback"
                columnName="message"
                columnDataType="TEXT"/>

        <dropNotNullConstraint
                tableName="feedback"
                columnName="scan_id"
                columnDataType="UUID"/>

        <addUniqueConstraint
                tableName="feedback"
                columnNames="user_id, scan_id"
                constraintName="uk_feedback_user_scan"/>

    </changeSet>

</databaseChangeLog>