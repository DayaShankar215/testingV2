<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-event-publication-table" author="bini">
        <createTable tableName="event_publication">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="listener_id" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="event_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="serialized_event" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="completion_date" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="add-publication-date-to-event-publication" author="bini">
        <addColumn tableName="event_publication">
            <column name="publication_date" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>